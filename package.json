{
  "main": "expo-router/entry",
  "name": "shift",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios --device",
    "prebuild": "expo prebuild --platform ios --clean",
    "bundle:check": "expo export --platform ios --output-dir .expo-export-check",
    "doctor": "expo-doctor",
    "test": "node --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "check:migrations": "node scripts/check-migrations.ts",
    "verify": "npm run typecheck && npm test && npm run check:migrations && npm run bundle:check",
    "catalog:fetch": "node scripts/fetch-dataset.ts",
    "catalog:build": "node scripts/build-catalog.ts",
    "catalog": "npm run catalog:fetch && npm run catalog:build -- --strict",
    "db:start": "npx --yes supabase start",
    "db:stop": "npx --yes supabase stop",
    "db:reset": "npx --yes supabase db reset",
    "db:test": "node scripts/db-test.ts"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.111.0",
    "expo": "^57.0.9",
    "expo-asset": "~57.0.8",
    "expo-build-properties": "~57.0.8",
    "expo-constants": "~57.0.8",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.10",
    "expo-file-system": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-image-manipulator": "~57.0.7",
    "expo-image-picker": "~57.0.7",
    "expo-keep-awake": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-router": "~57.0.9",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-worklets": "0.10.1",
    "tailwindcss": "^3.4.19",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "pg-query-emscripten": "^5.1.0",
    "typescript": "~6.0.3"
  }
}
